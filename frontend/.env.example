# Katha Frontend — Environment Variables
# Copy to .env for local dev, or set these in Vercel project settings for production

# Backend API base URL
# Local dev: leave empty (Vite proxy handles /api routing to localhost:8081)
# Production (Vercel): set this to your Render/Railway backend URL
# Example: VITE_API_BASE_URL=https://katha-backend.onrender.com/api
VITE_API_BASE_URL=
