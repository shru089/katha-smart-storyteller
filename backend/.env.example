# ===========================================
# KATHA - Smart Cultural Storyteller
# Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# Database Configuration
DATABASE_URL=sqlite:///./katha.db
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost/katha

# ===========================================
# API Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8081
DEBUG=True

# ===========================================
# CORS Origins (comma-separated)
# Add your deployed frontend URL here in production
# ===========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://katha.vercel.app

# ===========================================
# JWT Authentication
# IMPORTANT: Change JWT_SECRET_KEY before deploying!
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_BEFORE_DEPLOY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===========================================
# Google Gemini AI (for Rishi — the wise sage AI)
# Get your key at: https://aistudio.google.com/app/apikey
# ===========================================
GEMINI_API_KEY=

# ===========================================
# ElevenLabs (optional — for premium voice narration)
# https://elevenlabs.io
# ===========================================
ELEVENLABS_API_KEY=

# ===========================================
# Image Generation
# Pollinations.ai is used by default (free, no key needed).
# HuggingFace key is optional for fallback.
# ===========================================
HF_API_KEY=

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8081